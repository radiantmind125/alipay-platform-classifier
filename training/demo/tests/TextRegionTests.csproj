<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TextRegion 两个谓词(InRect / OnSegment)的验证。
    跑法:  cd training/demo/tests  然后  dotnet run
    全过返回 0, 有一条不过返回 1 —— 可以直接挂到流水线上。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TextRegionTests</AssemblyName>
    <RootNamespace>Ssp.Tests</RootNamespace>
    <!-- 只编 TextRegion.cs 一个文件, 它注释里 cref 到了 PinyinCheck, 那只是文档警告 -->
    <NoWarn>$(NoWarn);CS1574;CS1580;CS1584</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
  </ItemGroup>

  <ItemGroup>
    <!-- 相对路径, 换台机器照样能跑 -->
    <Compile Include="..\TextRegion.cs" Link="TextRegion.cs" />
  </ItemGroup>

</Project>
