<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FieldTimeCheck(页面时间比上传晚 / 订单号开头就是支付时间)的测试。
    用法见 Program.cs 顶上的注释。不用 OpenCV, 只看字段。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FieldTimeTest</AssemblyName>
    <RootNamespace>Ssp.FieldTimeTest</RootNamespace>
    <NoWarn>$(NoWarn);CS1574;CS1580;CS1584</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\FieldTimeCheck.cs" Link="FieldTimeCheck.cs" />
  </ItemGroup>

</Project>
