<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CircleCheck(蓝底成功页标题前圈对号检查)的批量测试。
    用法见 Program.cs 顶上的注释。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CircleTest</AssemblyName>
    <RootNamespace>Ssp.CircleTest</RootNamespace>
    <NoWarn>$(NoWarn);CS1574;CS1580;CS1584</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CircleCheck.cs" Link="CircleCheck.cs" />
  </ItemGroup>

</Project>
