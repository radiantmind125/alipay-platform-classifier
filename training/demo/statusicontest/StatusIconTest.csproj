<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StatusIconCheck(蓝图页头状态: 到账失败 / 提交成功)的批量测试。
    用法见 Program.cs 顶上的注释。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StatusIconTest</AssemblyName>
    <RootNamespace>Ssp.StatusIconTest</RootNamespace>
    <NoWarn>$(NoWarn);CS1574;CS1580;CS1584</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\StatusIconCheck.cs" Link="StatusIconCheck.cs" />
  </ItemGroup>

</Project>
