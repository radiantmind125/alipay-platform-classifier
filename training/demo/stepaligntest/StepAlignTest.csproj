<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StepAlignCheck(处理进度圆点上下对齐检查)的批量测试。
    用法见 Program.cs 顶上的注释(XML 注释里不能写两个连字符, 所以命令行写那边)。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StepAlignTest</AssemblyName>
    <RootNamespace>Ssp.StepAlignTest</RootNamespace>
    <NoWarn>$(NoWarn);CS1574;CS1580;CS1584</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
  </ItemGroup>

  <ItemGroup>
    <!-- 相对路径, 换台机器照样能跑 -->
    <Compile Include="..\StepAlignCheck.cs" Link="StepAlignCheck.cs" />
  </ItemGroup>

</Project>
